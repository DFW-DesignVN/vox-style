# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Image generation
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
# Keep enabled for graceful local fallback; set 0 to fail loudly when Gemini image generation is unavailable.
IMAGE_FALLBACK_ENABLED=1

# VOX TTS provider: auto | gemini | google | vieneu | capcut | elevenlabs
TTS_PROVIDER=auto
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# VieNeu-TTS v3 Turbo: local OpenAI-compatible server
VIENU_TTS_URL=http://127.0.0.1:8000
VIENU_TTS_MODEL=vieneu-v3-turbo
VIENU_TTS_VOICE=Mai Anh
VIENU_TTS_API_KEY=

# CapCut TTS fallback via K07VN/capcut-tts-api
CAPCUT_TTS_ENABLED=0
CAPCUT_PYTHON=python
CAPCUT_TTS_VOICE=BV074_streaming
CAPCUT_TTS_RATE=1.0
CAPCUT_TTS_TIMEOUT_MS=120000

# Optional premium fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
